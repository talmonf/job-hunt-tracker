generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  user
  admin
}

enum RegistrationMethod {
  password
  google
}

enum UiLanguage {
  en
  he
}

enum JobStatus {
  interest
  contacted
  applied
  interviewing
  offer
  rejected
  withdrawn
  on_hold
  parked
  not_applicable
}

enum EventType {
  interest
  outreach
  application
  meeting
  status_change
}

enum Channel {
  email
  whatsapp
  linkedin_inmail
  phone
  video
  in_person
  other
}

enum MeetingStage {
  hr
  manager
  technical
  final
  other
}

enum NoteType {
  interview_prep
  interview_debrief
  company_research
  follow_up
  thank_you
  other
  meeting_prep
  meeting_summary
  coffee_chat
  intro_request
  referral
  relationship
  reminder
  idea
  general
}

enum EmploymentType {
  full_time
  part_time
}

enum WorkArrangement {
  on_site
  remote
  hybrid
}

enum Engagement {
  employee
  freelance
}

enum CompanySize {
  under_10
  between_10_30
  between_31_100
  between_101_200
  between_201_1000
  between_1001_5000
  over_5000
}

enum EntityLinkKind {
  google_contact
  linkedin
  url
  local_contact
  manual
}

model User {
  id                   String     @id @default(cuid())
  email                String     @unique
  passwordHash         String?
  fullName             String
  role                 Role       @default(user)
  registeredWith       RegistrationMethod @default(password)
  lastAccessAt         DateTime?
  audienceTestUser     Boolean    @default(false)
  isActive             Boolean    @default(true)
  mustChangePassword   Boolean    @default(false)
  passwordChangedAt    DateTime?
  uiLanguage           UiLanguage @default(en)
  googleAccountId      String?    @unique
  timezone             String     @default("Asia/Jerusalem")
  digestEnabled        Boolean    @default(false)
  digestDaysAhead      Int        @default(7)
  digestHour           Int        @default(8)
  lastDigestLocalDate  String?
  calendarRefreshToken String?
  calendarEmail        String?
  contactsRefreshToken String?
  contactsEmail        String?
  aiPaySource          AiPaySource @default(key)
  creditBalance        Int         @default(0)
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  goals         UserGoals?
  profile       Profile?
  employments   Employment[]
  educations    Education[]
  volunteers    VolunteerRole[]
  certificates  Certificate[]
  profileFiles  ProfileFile[]
  jobs          Job[]
  companies     Company[]
  contacts      Contact[]
  notes         Note[]
  events        Event[]
  notifications Notification[]
  entityLinks   EntityLink[]
  tags          Tag[]
  aiKeys        AiProviderKey[]
  aiUsage       AiUsage[]
  creditLedger  CreditLedger[]
  profileLabels ProfileLabel[]
  flavors       Flavor[]
  profileImports ProfileImport[]
}

model UserGoals {
  id                             String @id @default(cuid())
  userId                         String @unique
  user                           User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  applicationsPerDay             Float  @default(0)
  networkingPerDay               Float?
  networkingPerWeek              Float?
  interviewPracticeMinutesPerDay Float  @default(0)
  learningMinutesPerDay          Float  @default(0)
  searchMinutesOverride          Float?
}

model Profile {
  id       String @id @default(cuid())
  userId   String @unique
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  headline String @default("")
  aboutEn  String @default("")
  aboutHe  String @default("")
}

model Employment {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String
  company       String
  startDate     DateTime?
  endDate       DateTime?
  isCurrent     Boolean   @default(false)
  descriptionEn String    @default("")
  descriptionHe String    @default("")
  tags          EmploymentTag[]
  bullets       EmploymentBullet[]
  flavors       FlavorEmployment[]
}

model Education {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  school    String
  degree    String    @default("")
  field     String    @default("")
  startDate DateTime?
  endDate   DateTime?
}

model VolunteerRole {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization  String
  role          String    @default("")
  startDate     DateTime?
  endDate       DateTime?
  descriptionEn String    @default("")
  descriptionHe String    @default("")
}

model Certificate {
  id       String    @id @default(cuid())
  userId   String
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name     String
  issuer   String    @default("")
  issuedOn DateTime?
  url      String    @default("")
}

/// A private S3 object. objectKey is the key in S3_BUCKET, not a public URL.
model ProfileFile {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  filename   String
  objectKey  String
  mime          String
  byteSize      Int
  extractedText String   @default("")
  uploadedAt    DateTime @default(now())
}

model Company {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  nameKey       String
  offices       String   @default("")
  websiteHome   String   @default("")
  websitePeople String   @default("")
  websiteJobs   String   @default("")
  linkedinUrl   String   @default("")
  foundedOn     String       @default("")
  employeeCount CompanySize?
  following     Boolean      @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  jobs          Job[]
  contacts      ContactCompany[]
  notes         Note[]
  tags          CompanyTag[]

  @@unique([userId, nameKey])
  @@index([userId, following])
}

model Job {
  id                     String    @id @default(cuid())
  userId                 String
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId              String
  company                Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  companyName            String
  title                  String    @default("")
  location               String    @default("")
  employmentType         EmploymentType?
  workArrangement        WorkArrangement?
  engagement             Engagement?
  description            String    @default("")
  interestDate           DateTime
  followUpAt             DateTime?
  followUpNote           String    @default("")
  reminderLeadDays       Int?
  reminderLeadHours      Int?
  followUpReminderSentAt DateTime?
  status                 JobStatus @default(interest)
  importKey              String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  urls                   JobUrl[]
  cvs                    JobCv[]
  events                 Event[]
  notes                  Note[]
  entityLinks            EntityLink[]
  tags                   JobTag[]

  @@unique([userId, importKey])
  @@index([userId, status])
  @@index([companyId])
}

model JobUrl {
  id    String @id @default(cuid())
  jobId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  url   String
  label String @default("")
}

/// A private S3 object. objectKey is the key in S3_BUCKET, not a public URL.
model JobCv {
  id         String   @id @default(cuid())
  jobId      String
  job        Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  filename   String
  objectKey  String
  mime       String
  byteSize   Int
  uploadedAt DateTime @default(now())
  events     Event[]
}

model Contact {
  id                 String    @id @default(cuid())
  userId             String
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName           String
  firstName          String    @default("")
  lastName           String    @default("")
  firstNameHe        String    @default("")
  lastNameHe         String    @default("")
  role               String    @default("")
  workplace          String    @default("")
  howWeMet           String    @default("")
  lastChannel        String    @default("")
  status             String    @default("")
  summary            String    @default("")
  contactedAt        DateTime?
  nextActionDate     DateTime?
  nextAction         String    @default("")
  mobile             String    @default("")
  email              String    @default("")
  address            String    @default("")
  contactDetails     String    @default("")
  willingToRecommend Boolean   @default(false)
  googleResourceName String?
  linkedinUrl        String    @default("")
  importKey          String?
  createdAt          DateTime  @default(now())
  events             Event[]
  notes              Note[]
  entityLinks        EntityLink[] @relation("LinkContact")
  parentLinks        EntityLink[] @relation("ParentContact")
  tags               ContactTag[]
  companies          ContactCompany[]

  @@unique([userId, importKey])
  @@index([userId, fullName])
}

model ContactCompany {
  contactId      String
  companyId      String
  contact        Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  company        Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  startedOn      String  @default("")
  startedUnknown Boolean @default(false)
  endedOn        String  @default("")
  endedUnknown   Boolean @default(false)

  @@id([contactId, companyId])
  @@index([companyId])
}

model Note {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title          String
  jobId          String?
  job            Job?     @relation(fields: [jobId], references: [id], onDelete: SetNull)
  contactId      String?
  contact        Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  companyId      String?
  company        Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  type           NoteType @default(interview_prep)
  additionalInfo String   @default("")
  bodyEn         String   @default("")
  bodyHe         String   @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt
  events         Event[]
  entityLinks    EntityLink[]
  tags           NoteTag[]

  @@index([userId, createdAt])
  @@index([jobId])
  @@index([contactId])
  @@index([companyId])
}

model EntityLink {
  id                 String          @id @default(cuid())
  userId             String
  user               User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind               EntityLinkKind
  displayName        String
  title              String          @default("")
  googleResourceName String?
  url                String          @default("")
  contactId          String?
  contact            Contact?        @relation("LinkContact", fields: [contactId], references: [id], onDelete: SetNull)
  jobId              String?
  job                Job?            @relation(fields: [jobId], references: [id], onDelete: Cascade)
  noteId             String?
  note               Note?           @relation(fields: [noteId], references: [id], onDelete: Cascade)
  parentContactId    String?
  parentContact      Contact?        @relation("ParentContact", fields: [parentContactId], references: [id], onDelete: Cascade)
  firstName          String          @default("")
  lastName           String          @default("")
  phone              String          @default("")
  email              String          @default("")
  worksThere         String          @default("")
  connection         String          @default("")
  relationshipNote   String          @default("")
  createdAt          DateTime        @default(now())

  @@index([userId, jobId])
  @@index([userId, noteId])
  @@index([userId, parentContactId])
}

model Event {
  id                     String        @id @default(cuid())
  userId                 String
  user                   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type                   EventType
  occurredAt             DateTime
  startsAt               DateTime?
  endsAt                 DateTime?
  jobId                  String?
  job                    Job?          @relation(fields: [jobId], references: [id], onDelete: SetNull)
  contactId              String?
  contact                Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  channel                Channel?
  counterpartyName       String        @default("")
  stage                  MeetingStage?
  resultingStatus        JobStatus?
  previousStatus         JobStatus?
  summary                String        @default("")
  noteId                 String?
  note                   Note?         @relation(fields: [noteId], references: [id], onDelete: SetNull)
  cvId                   String?
  cv                     JobCv?        @relation(fields: [cvId], references: [id], onDelete: SetNull)
  tailoredCv             Boolean?
  googleCalendarEventId  String?
  googleCalendarHtmlLink String?
  importKey              String?
  createdAt              DateTime      @default(now())

  @@unique([userId, importKey])
  @@index([userId, occurredAt])
  @@index([userId, startsAt])
  @@index([jobId, occurredAt])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String
  dedupeKey String
  subject   String
  body      String
  emailed   Boolean   @default(false)
  createdAt DateTime  @default(now())
  emailedAt DateTime?

  @@unique([userId, dedupeKey])
}

enum TagColor {
  red
  rose
  pink
  fuchsia
  purple
  violet
  indigo
  blue
  sky
  cyan
  teal
  emerald
  green
  lime
  yellow
  amber
  orange
}

model Tag {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  color       TagColor
  createdAt   DateTime @default(now())
  jobs        JobTag[]
  contacts    ContactTag[]
  notes       NoteTag[]
  employments EmploymentTag[]
  companies   CompanyTag[]

  @@unique([userId, name])
  @@index([userId])
}

model JobTag {
  jobId String
  tagId String
  job   Job @relation(fields: [jobId], references: [id], onDelete: Cascade)
  tag   Tag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([jobId, tagId])
  @@index([tagId])
}

model ContactTag {
  contactId String
  tagId     String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([contactId, tagId])
  @@index([tagId])
}

model NoteTag {
  noteId String
  tagId  String
  note   Note @relation(fields: [noteId], references: [id], onDelete: Cascade)
  tag    Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([noteId, tagId])
  @@index([tagId])
}

model EmploymentTag {
  employmentId String
  tagId        String
  employment   Employment @relation(fields: [employmentId], references: [id], onDelete: Cascade)
  tag          Tag        @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([employmentId, tagId])
  @@index([tagId])
}

model CompanyTag {
  companyId String
  tagId     String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([companyId, tagId])
  @@index([tagId])
}

enum AiProvider {
  anthropic
  google
  openai
  openrouter
}

enum AiPaySource {
  key
  credits
}

enum ProfileLabelKind {
  skill
  theme
}

enum ImportStatus {
  pending
  accepted
  discarded
}

model AiProviderKey {
  id         String     @id @default(cuid())
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider   AiProvider
  ciphertext String
  lastFour   String
  model      String
  updatedAt  DateTime   @updatedAt

  @@unique([userId, provider])
}

model AiUsage {
  id               String      @id @default(cuid())
  userId           String
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  feature          String
  provider         AiProvider
  model            String
  inputTokens      Int
  outputTokens     Int
  paySource        AiPaySource
  estimatedAgorot  Int
  debitAgorot      Int         @default(0)
  createdAt        DateTime    @default(now())

  @@index([userId, createdAt])
}

model AiPlatform {
  id             String @id @default("default")
  markupPercent  Int    @default(20)
  usdToIls       Float  @default(3.7)
}

model CreditPack {
  id           String  @id @default(cuid())
  nameEn       String
  nameHe       String
  creditAgorot Int
  priceAgorot  Int
  active       Boolean @default(true)
  sortOrder    Int     @default(0)
}

model CreditLedger {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  delta           Int
  kind            String
  note            String   @default("")
  stripeSessionId String?  @unique
  createdAt       DateTime @default(now())

  @@index([userId, createdAt])
}

model ProfileLabel {
  id      String           @id @default(cuid())
  userId  String
  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind    ProfileLabelKind
  name    String
  flavors FlavorLabel[]

  @@unique([userId, kind, name])
  @@index([userId])
}

model EmploymentBullet {
  id           String   @id @default(cuid())
  employmentId String
  employment   Employment @relation(fields: [employmentId], references: [id], onDelete: Cascade)
  userId       String
  position     Int
  textEn       String   @default("")
  textHe       String   @default("")
  flavors      FlavorBullet[]

  @@index([employmentId, position])
}

model Flavor {
  id          String             @id @default(cuid())
  userId      String
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  employments FlavorEmployment[]
  bullets     FlavorBullet[]
  labels      FlavorLabel[]

  @@index([userId])
}

model FlavorEmployment {
  flavorId     String
  employmentId String
  flavor       Flavor     @relation(fields: [flavorId], references: [id], onDelete: Cascade)
  employment   Employment @relation(fields: [employmentId], references: [id], onDelete: Cascade)

  @@id([flavorId, employmentId])
  @@index([employmentId])
}

model FlavorBullet {
  flavorId String
  bulletId String
  flavor   Flavor           @relation(fields: [flavorId], references: [id], onDelete: Cascade)
  bullet   EmploymentBullet @relation(fields: [bulletId], references: [id], onDelete: Cascade)

  @@id([flavorId, bulletId])
  @@index([bulletId])
}

model FlavorLabel {
  flavorId String
  labelId  String
  flavor   Flavor       @relation(fields: [flavorId], references: [id], onDelete: Cascade)
  label    ProfileLabel @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([flavorId, labelId])
  @@index([labelId])
}

model ProfileImport {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    ImportStatus @default(pending)
  payload   Json
  createdAt DateTime     @default(now())

  @@index([userId, status])
}
