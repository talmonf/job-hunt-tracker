# Neon connection string. A host without "-pooler" is fine for this app.
DATABASE_URL=postgresql://USER:PASSWORD@ep-EXAMPLE.REGION.aws.neon.tech/neondb?sslmode=require
AUTH_SECRET=replace-with-a-long-random-string
AUTH_URL=http://localhost:3000
APP_ENCRYPTION_KEY=replace-with-32-byte-base64
CRON_SECRET=replace-with-a-long-random-string
PASSWORD_MAX_AGE_MONTHS=6
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
# Private S3 bucket. The database stores the object key, not a public URL.
S3_BUCKET=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
